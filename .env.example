# ==============================================================================
# Local Docker Compose Settings
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meetings_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ==============================================================================
# AWS Credentials & Deployment Configuration
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=your_optional_session_token
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ==============================================================================
# AWS Infrastructure Variables (Optional overrides for infra/variables.tf)
# ==============================================================================
TF_VAR_aws_region=us-east-1
TF_VAR_project_name=meeting-app
TF_VAR_environment=production
TF_VAR_db_name=meetings_db
TF_VAR_db_username=postgres
TF_VAR_db_password=YourSecurePassword2026!
TF_VAR_db_instance_class=db.t3.micro
TF_VAR_fargate_cpu=256
TF_VAR_fargate_memory=512
